# Compiled subroutine leftovers
*.obj
*.mod
*.o
*.a
*.dll
*.exe
standardU.*
explicitU.*

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
*.pyc
*.pyo
__pycache__/
.venv/
venv/

# ---------------------------------------------------------------------------
# Local scratch / run directories
# ---------------------------------------------------------------------------
run/
runs/
scratch/
_scratch/
out/
results/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.cursor/
.claude/
.skills/
.agents/
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Exceptions
# ---------------------------------------------------------------------------
# Test-agent reports ARE part of the repository -- they are the record of what
# was actually run and on what machine. Only the job files inside them are not.
!briefs/results/
!briefs/results/**
briefs/results/**/*.odb
briefs/results/**/*.inp

# Small reference decks that are part of the teaching material must be
# force-added:  git add -f examples/*/reference/*.inp
!examples/**/reference/*.inp
